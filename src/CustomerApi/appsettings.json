{
  "ConnectionStrings": {
    "Database": "",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../../logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "WeatherApi": {
    "BaseUrl": "https://api.open-meteo.com",
    "Polly": {
      "RetryPolicy": {
        "RetryTimerInSeconds": [3, 5, 10]
      },
      "CircuitBreak": {
        "ExceptionsAllowedBeforeBreak": 3,
        "BreakDurationInSeconds": 30
      }
    }
  },
  "AllowedHosts": "*"
}
